{
  // Workspace tuning for this repo. Added 2026-08-18 after a local-model load
  // triggered a WSL2 global OOM that rebooted the VM and wiped the in-memory
  // HydraDB graph.
  //
  // Measured cause: 66,407 files under the workspace with nothing excluded.
  //   .venv            42,313 files (14,987 .py), 5.1 GB
  //   data/medlocomo   15,369 files, 516 MB   (fetched corpus, gitignored)
  //   data/llm_cache    7,029 files, 40 MB    (completion cache, gitignored)
  //   data/index          161 files, 347 MB   (saved embeddings, gitignored)
  //
  // The file watcher tracked all of them, workspace search indexed them, and
  // Pylance analysed every .py inside .venv. On a 15.9 GB WSL2 box that left
  // too little headroom for local inference.

  // --- File watcher -------------------------------------------------------
  // None of these change while editing, so watching them buys nothing.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/data/**": true,
    "**/results/**": true,
    "**/results-*/**": true,
    "**/.git/objects/**": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true,
    "**/.ruff_cache/**": true,
    "**/*.egg-info/**": true
  },

  // --- Search -------------------------------------------------------------
  // Keep .venv searchable-on-demand but out of the default index; data/ holds
  // patient dialogue that must never surface in a quick-open or a screen share.
  "search.exclude": {
    "**/.venv/**": true,
    "**/data/**": true,
    "**/results/**": true,
    "**/results-*/**": true,
    "**/__pycache__/**": true,
    "**/uv.lock": true
  },
  "search.followSymlinks": false,

  // --- Python analysis ----------------------------------------------------
  // `.venv` is deliberately NOT excluded here: Pylance needs it to resolve
  // imports and types. Excluding it would save memory and break autocomplete.
  // What IS excluded is data/results, which contain no importable code.
  "python.analysis.exclude": ["**/data/**", "**/results/**", "**/results-*/**"],
  // Analyse only open files. Workspace-wide diagnostics on a tree this size is
  // the single largest Pylance memory cost and adds little here.
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.indexing": true,
  "python.analysis.userFileIndexingLimit": 2000,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // --- Test discovery -----------------------------------------------------
  // Discovery must not run the `live`/`slow` marks: those need a booted HydraDB
  // and load real ML models, so a background discovery pass could hit the
  // network, the GPU, or the LLM budget without anyone asking.
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "-m", "not live and not slow"],
  "python.testing.autoTestDiscoverOnSaveEnabled": false,

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true
  }
}
